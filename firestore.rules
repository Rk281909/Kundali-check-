rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function existing() {
      return resource.data;
    }

    function incoming() {
      return request.resource.data;
    }

    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // User Validation
    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email', 'createdAt']) &&
             data.uid is string && data.uid.size() <= 128 && data.uid == request.auth.uid &&
             data.email is string && data.email.size() <= 256 &&
             data.createdAt is timestamp;
    }

    match /users/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      // Admin list is fine, user list only if it's them. Actually, wait 'allow list' needs to restrict to the user's ID
      allow list: if isSignedIn() && (request.auth.uid == userId || isAdmin());

      allow create: if isSignedIn() && request.auth.uid == userId &&
                       isValidUser(incoming()) && incoming().createdAt == request.time &&
                       (!('role' in incoming()) || incoming().role == 'user');

      allow update: if isSignedIn() && request.auth.uid == userId &&
                       isValidUser(incoming()) &&
                       (isAdmin() || 
                        (!('role' in incoming().diff(existing()).affectedKeys()) && 
                         !('subscriptionPlan' in incoming().diff(existing()).affectedKeys())));
    }

    function isValidChatSession(data) {
      return data.keys().hasAll(['userId', 'createdAt']) &&
             data.userId is string && data.userId == request.auth.uid &&
             data.createdAt is timestamp;
    }

    match /chatSessions/{sessionId} {
      allow read: if isSignedIn() && existing().userId == request.auth.uid;
      allow create: if isSignedIn() && isValidChatSession(incoming()) && incoming().createdAt == request.time;
      allow update: if isSignedIn() && existing().userId == request.auth.uid && isValidChatSession(incoming());
      allow delete: if isSignedIn() && existing().userId == request.auth.uid;

      match /messages/{messageId} {
        allow read: if isSignedIn() && get(/databases/$(database)/documents/chatSessions/$(sessionId)).data.userId == request.auth.uid;
        allow create: if isSignedIn() && get(/databases/$(database)/documents/chatSessions/$(sessionId)).data.userId == request.auth.uid &&
                         incoming().role in ['user', 'model'] &&
                         incoming().text is string && incoming().text.size() <= 100000 &&
                         incoming().createdAt == request.time;
      }
    }

    function isValidReport(data) {
      return data.keys().hasAll(['userId', 'type', 'content', 'createdAt']) &&
             data.userId is string && data.userId == request.auth.uid &&
             data.type in ['kundli', 'tarot', 'palm', 'compatibility', 'numerology'] &&
             data.content is string && data.content.size() <= 100000 &&
             data.createdAt is timestamp;
    }

    match /reports/{reportId} {
      allow read: if isSignedIn() && existing().userId == request.auth.uid;
      allow create: if isSignedIn() && isValidReport(incoming()) && incoming().createdAt == request.time;
      allow update: if isSignedIn() && existing().userId == request.auth.uid && isValidReport(incoming());
      allow delete: if isSignedIn() && existing().userId == request.auth.uid;
    }
  }
}
